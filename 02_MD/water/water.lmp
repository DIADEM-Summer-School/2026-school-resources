# LAMMPS Input File
# Licensed under CC BY 4.0
# A Set of Tutorials for the LAMMPS Simulation Package (LiveCoMS, 2025)
# By Simon Gravelle, Cecilia M. S. Alvares, Jacob R. Gissinger, and Axel Kohlmeyer
# Please cite doi.org/10.33011/livecoms.6.1.3037
# Find more on GitHub: https://github.com/lammpstutorials

units real
atom_style full
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long 10
kspace_style ewald 1e-5

region box block -15 15 -15 15 -15 15
  create_box 2 box &
  bond/types 1 &
  angle/types 1 &
  extra/bond/per/atom 2 &
  extra/angle/per/atom 2 &
  extra/special/per/atom 2

mass 1 15.9994 # H2O O (SPC/Fw)
mass 2 1.008 # H2O H (SPC/Fw)

pair_coeff 1 1 0.155 3.165
pair_coeff 2 2 0.0 0.0
bond_coeff 1 529.581 1.012
angle_coeff 1 37.95 113.24

molecule h2omol water.mol
create_atoms 0 random 350 87910 NULL mol h2omol 454756 overlap 1.0 maxtry 50

group H2O type 1 2
minimize 1.0e-4 1.0e-6 100 1000
reset_timestep 0

fix mynpt all npt temp 300 300 100 iso 1 1 1000

dump viz all image 250 myimage-*.ppm type type &
  shiny 0.1 box no 0.01 view 0 90 zoom 1.6 size 1000 1000
dump_modify viz backcolor white &
  acolor 1 red acolor 2 white &
  adiam 1 3 adiam 2 1.5

dump traj all atom 250 dump.lammpstrj

thermo 500
thermo_style custom step temp etotal vol density

timestep 1.0
run 15000
